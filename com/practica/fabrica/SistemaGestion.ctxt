comment18.text=\r\n\ Da\ de\ alta\ a\ un\ mec\u00E1nico\ de\ cinta.\r\n\r\n\ @param\ mecanico\ mec\u00E1nico\ a\ registrar\r\n
comment19.params=
comment19.target=java.util.List\ consultarMecanico()
comment19.text=\r\n\ @return\ lista\ de\ mec\u00E1nicos\ registrados\r\n
